{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevSetup",
  "mainBinaryName": "devsetup",
  "version": "0.0.3",
  "identifier": "dev.devsetup.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevSetup",
        "width": 1100,
        "height": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Set up a development machine in a few clicks",
    "longDescription": "DevSetup installs and removes developer tools by role, keeps them updated, cleans up, and runs disposable Docker services for a project.",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "pkexec | policykit-1"
        ],
        "section": "devel",
        "files": {
          "/usr/share/polkit-1/actions/dev.devsetup.helper.policy": "../packaging/dev.devsetup.helper.policy"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ByteNinjas/DevSetup/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0NUNGNzNBNzAzRjVGNzcKUldSM1h6OXdPdmRjcEJtc21Remc0aStRekxCdGhrR0FNY1FkdGtDbWtaZ0lyUWJHRklRT05WWDIK",
      "requireSignedVersion": true
    }
  }
}
